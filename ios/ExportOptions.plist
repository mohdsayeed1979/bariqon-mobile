<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	Used by `xcodebuild -exportArchive` (and `flutter build ipa`) to export
	a signed .ipa for TestFlight/App Store from an .xcarchive. "app-store"
	is the correct method for both — TestFlight builds are uploaded the
	same way as App Store submissions, just held in review-pending state
	until you choose to release them.
	-->
	<key>method</key>
	<string>app-store</string>
	<key>teamID</key>
	<string>HNAQT9S36Q</string>
	<key>signingStyle</key>
	<string>automatic</string>
	<key>uploadSymbols</key>
	<true/>
	<key>stripSwiftSymbols</key>
	<true/>
	<key>compileBitcode</key>
	<false/>
</dict>
</plist>
